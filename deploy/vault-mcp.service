[Unit]
Description=Brain Vault MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/vault-mcp
Environment=VAULT_DB_PATH=/home/pi/.vault/brain.db
Environment=VAULT_CACHE=/home/pi/.vault/models
Environment=VAULT_TRANSPORT=http
Environment=VAULT_HOST=127.0.0.1
Environment=VAULT_PORT=8765
Environment=VAULT_MODEL=intfloat/multilingual-e5-small
EnvironmentFile=/home/pi/.vault/secrets.env
ExecStart=/home/pi/vault-mcp/.venv/bin/python -m vault.server
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/.vault
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6

[Install]
WantedBy=multi-user.target

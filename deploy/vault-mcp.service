[Unit]
Description=Brain Vault MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vault
Group=vault
WorkingDirectory=/opt/vault-mcp
# HOME / HF_HOME keep any stray model-cache writes inside the one writable path.
Environment=HOME=/var/lib/vault-mcp
Environment=HF_HOME=/var/lib/vault-mcp/hf
Environment=VAULT_DB_PATH=/var/lib/vault-mcp/brain.db
Environment=VAULT_CACHE=/var/lib/vault-mcp/models
Environment=VAULT_TRANSPORT=http
Environment=VAULT_HOST=127.0.0.1
Environment=VAULT_PORT=8765
# Set to your public hostname for strict Host validation (recommended).
# Left empty, DNS-rebinding/Host checks are disabled (the bearer token still gates).
Environment=VAULT_PUBLIC_HOST=
Environment=VAULT_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EnvironmentFile=/etc/vault-mcp/secrets.env
ExecStart=/opt/vault-mcp/.venv/bin/python -m vault.server
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vault-mcp
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# db.py sets PRAGMA cipher_memory_security=ON, which mlock()s sensitive SQLCipher
# memory so keys/plaintext can't be swapped to disk. The default RLIMIT_MEMLOCK
# is too small, so the lock fails (mlock() errno=12 ENOMEM) and the hardening
# silently no-ops. Raise it so the (small) secure heap can actually be locked;
# real locked memory stays bounded by what SQLCipher allocates.
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
